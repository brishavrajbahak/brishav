# Same-origin is used when this value is empty.
NEXT_PUBLIC_API_BASE_URL=

# Public widget key only. Never add TURNSTILE_SECRET_KEY to the frontend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional. Resume controls remain hidden while this is empty.
NEXT_PUBLIC_RESUME_URL=

# Set to 1 for Cloudflare branch previews to emit noindex metadata.
NEXT_PUBLIC_PREVIEW_DEPLOYMENT=0
